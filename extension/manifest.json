{
  "name": "Manga Colorizer (AI9)",
  "version": "0.6.5",
  "description": "Automatic local-GPU manga colorization for Crunchyroll Manga and other reader sites, backed by AI9.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://crunchyroll.com/*",
    "*://*.crunchyroll.com/*",
    "*://mangadex.org/*",
    "*://senkuro.com/*",
    "*://chapmanganelo.com/*",
    "*://fanfox.net/*",
    "*://mangakakalot.com/*",
    "*://readmanga.io/*",
    "*://manhuatop.org/*",
    "*://manhuaus.com/*",
    "*://mangapill.com/*",
    "*://*.readdetectiveconan.com/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*",
    "*://*/*"
  ],

  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["siteConfig.json"]
    }
  ],

  "action": {
    "default_icon": {
      "16": "assets/ext-icon.png",
      "24": "assets/ext-icon.png",
      "32": "assets/ext-icon.png"
    },
    "default_title": "Manga Colorizer",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "manifest_version": 3
}
